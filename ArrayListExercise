            // Create a one - dimensional Array of strings.Ask the user to select an index of the Array and then display the string at that index on the screen.
            
            string[] countries = { "India", "USA", "UK", "Australia", "Germany" };
            var selectedIndex=0;
            var isValidIndex = false;
            while (!isValidIndex)
            {
                Console.WriteLine("Select an index of the Array (0-4): ");
                var input = Console.ReadLine();
                if (int.TryParse(input, out selectedIndex) && selectedIndex >= 0 && selectedIndex < countries.Length)
                {
                    isValidIndex = true;
                }
                else
                {
                    Console.WriteLine("Invalid index. Please try again.");
                }
            }

            Console.WriteLine($"You selected: {countries[selectedIndex]}");
            



           // Create a one - dimensional Array of integers.Ask the user to select an index of the Array and then display the integer at that index on the screen.

