using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace CSharp2_Assignment
{

    interface IQuittable // Define an interface called IQuittable
    {
        void Quit(); // Define a method called Quit
    }

    public class Employee : IQuittable // Define a class called Employee that implements the IQuittable interface
    {
        public string FirstName { get; set; } // Define a property for the first name of the employee
        public string LastName { get; set; } // Define a property for the last name of the employee

        public void Quit() // Implement the Quit method from the IQuittable interface
        {
            Console.WriteLine($"{FirstName} {LastName} has quit.");
        }
    }
    internal class Program
    {
        static void Main(string[] args)
        {
            /* Create an interface called IQuittable and have it define a void method called Quit().
             * Have your Employee class from the previous drill inherit that interface and implement 
             * the Quit() method in any way you choose.
             * Use polymorphism to create an object of type IQuittable and call the Quit() method on it. 
             * Hint: an object can be of an interface type if it implements that specific interface.
             * Add comments to each line or block of your code to explain what it does exactly, 
             * so that another developer could read and understand your code. 
             * 
             */
            Employee employee = new Employee() // Create an instance of the Employee class 
            {
                FirstName = "Naseem", // Set the first name of the employee
                LastName = "Ganji "   // Set the last name of the employee
            };
            employee.Quit(); // Call the Quit method on the employee instance
        }
    }
}
